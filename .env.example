# Customer and scheme storage (unchanged by Firebase Authentication).
MONGODB_URI=
MONGODB_DB=sklcf

# Firebase Web App configuration (public identifiers, inlined at build time).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin SDK credentials (server only; NEVER use NEXT_PUBLIC_ here).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Keep PEM newlines, or paste escaped \n sequences.
FIREBASE_PRIVATE_KEY=
# UID of the pre-provisioned sklcf66@gmail.com account. Required for owner access.
FIREBASE_ADMIN_UID=
